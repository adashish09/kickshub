# KicksHub Backend Environment Variables
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=replace-with-a-random-secret-key-in-production
JWT_SECRET_KEY=replace-with-a-random-jwt-secret-in-production
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
DATABASE_URL=mysql+pymysql://kickshub_user:replace-me@127.0.0.1:3306/kickshub
FRONTEND_ORIGIN=http://localhost:5173
PORT=5000

# Production Cookie Settings (Set SameSite=None and Secure=True when frontend is on Vercel and backend is on Render)
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_SECURE=False
